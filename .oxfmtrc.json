{
   "$schema": "./node_modules/oxfmt/configuration_schema.json",
   "printWidth": 100,
   "useTabs": false,
   "tabWidth": 3,
   "semi": false,
   "singleQuote": true,
   "trailingComma": "es5",
   "sortImports": false,
   "sortPackageJson": false,
   "ignorePatterns": ["**/node_modules", "**/.git"]
}
